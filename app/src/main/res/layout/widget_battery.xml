<?xml version="1.0" encoding="utf-8"?>
<!--
    One slim row, transparent background: three cells of ring+picture (bitmaps from WidgetArt) with
    the percentage beside each, packed together and centred rather than spread across the width.
    Text carries a light halo so it reads on any wallpaper.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:baselineAligned="false"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="2dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/widget_left_art"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/widget_left"
            android:src="@drawable/art_pod_left" />
        <TextView
            android:id="@+id/widget_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:shadowColor="#CCFFFFFF"
            android:shadowRadius="5"
            android:text="@string/widget_unknown"
            android:textColor="#1C1C1E"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/widget_right_art"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/widget_right"
            android:src="@drawable/art_pod_right" />
        <TextView
            android:id="@+id/widget_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:shadowColor="#CCFFFFFF"
            android:shadowRadius="5"
            android:text="@string/widget_unknown"
            android:textColor="#1C1C1E"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/widget_case_art"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/widget_case"
            android:src="@drawable/art_case" />
        <TextView
            android:id="@+id/widget_case"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:shadowColor="#CCFFFFFF"
            android:shadowRadius="5"
            android:text="@string/widget_unknown"
            android:textColor="#1C1C1E"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
